# TRACE — environment template. Copy to .env (never commit .env).
# Mode: demo | live | test
TRACE_MODE=demo
TRACE_DATA_DIR=./data

# Exa neural web search (https://exa.ai) — Task-3 pipeline discovery leg
EXA_API_KEY=

# Reverse-image search provider: demo | tineye | serpapi
REVERSE_SEARCH_PROVIDER=demo
# TinEye (https://services.tineye.com/) — API key for live search
TINEYE_API_KEY=
TINEYE_API_URL=https://api.tineye.com/api/v1/result_json/
# SerpApi Google Lens (https://serpapi.com/google-lens-api) — API key for live search
SERPAPI_API_KEY=
SERPAPI_API_URL=https://serpapi.com/search.json

# Task-3 pipeline chain selection: --chain local (default, ganache) or
# --chain sepolia (Ethereum Sepolia testnet via SEPOLIA_RPC_URL).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=
# Blockchain anchoring (EVM). Leave empty to run with "CHAIN NOT CONFIGURED".
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_APP_VERSION=0.1.0

# Live provider contract tests are opt-in only:
# RUN_LIVE_PROVIDER_TESTS=true
